# Copy to .env (git-ignored) and replace the placeholders. Never commit real values.
POSTGRES_USER=antriaja
POSTGRES_DB=antriaja
# Generate one: openssl rand -hex 24  (hex avoids URL-escaping issues in DATABASE_URL)
POSTGRES_PASSWORD=replace-me

# Admin sign-in (Auth.js + Google). Create an OAuth client in Google Cloud Console:
# redirect URI = <base url>/api/auth/callback/google
ADMIN_EMAILS=admin@example.com,another@example.com
AUTH_SECRET=replace-me          # openssl rand -base64 32
AUTH_GOOGLE_ID=replace-me
AUTH_GOOGLE_SECRET=replace-me
AUTH_TRUST_HOST=true            # app runs behind Cloudflare/cloudflared
# Signs staff cookies; at least 32 characters.
STAFF_COOKIE_SECRET=replace-me  # openssl rand -base64 32
